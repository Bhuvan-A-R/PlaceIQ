# Copy to .env and fill in. Never commit .env.

# LLM provider: mock | anthropic | openai | ollama
# "mock" never calls a model; answers are clearly labelled as extractive demo output.
# anthropic: needs `pip install anthropic`, PLACEBOT_LLM_API_KEY and PLACEBOT_LLM_MODEL.
# openai: needs `pip install openai` (+ optional PLACEBOT_LLM_BASE_URL for OpenAI-compatible servers).
# ollama: local server, set PLACEBOT_LLM_MODEL (and PLACEBOT_LLM_BASE_URL if not localhost:11434).
PLACEBOT_LLM_PROVIDER=mock
PLACEBOT_LLM_MODEL=
PLACEBOT_LLM_API_KEY=
PLACEBOT_LLM_BASE_URL=

# Embeddings: sentence-transformers model name. If the package or model is unavailable,
# PlaceBot falls back to a local hashing embedder and says so in the UI/logs.
PLACEBOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
PLACEBOT_CHUNK_TARGET_TOKENS=300
PLACEBOT_CHUNK_MAX_TOKENS=400
PLACEBOT_CHUNK_OVERLAP_TOKENS=40

# Retrieval
PLACEBOT_TOP_K=6
PLACEBOT_CANDIDATE_K=20
PLACEBOT_RRF_K=60
PLACEBOT_CONTEXT_TOKEN_BUDGET=1800
# Evidence thresholds (retrieval signals, NOT probabilities). Tune with the evaluation script.
PLACEBOT_MIN_BM25_SCORE=0.5
PLACEBOT_MIN_VECTOR_SCORE=0.20
# Fraction of informative query terms that must appear in the top retrieved passages
PLACEBOT_MIN_TERM_COVERAGE=0.40

# Documents
PLACEBOT_MAX_UPLOAD_MB=20

# Generation
PLACEBOT_LLM_MAX_TOKENS=700
PLACEBOT_LLM_TIMEOUT_S=60

# Provenance log (stores a short question hash + source documents; never student data). true | false
PLACEBOT_LOG_ANSWERS=true
